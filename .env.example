# Copied to .env (gitignored) by `pnpm local` / `pnpm dev`. Never put real keys in THIS file.
NODE_ENV=development
LOG_LEVEL=info
DB_PATH=./data/devagent.db
HEARTBEAT_SECONDS=30

# Solana: devnet, localnet or mainnet-beta. Mainnet uses REAL SOL and also needs REAL_MONEY=1.
SOLANA_CLUSTER=devnet
REAL_MONEY=0
# Custom RPC. Strongly recommended on mainnet (Helius, QuickNode, Triton); the public one is rate limited.
SOLANA_RPC_URL=
# How often the orchestrator reads agent wallets and coin prices from chain.
CHAIN_POLL_SECONDS=60
# Fixed SOL price in USD for budget and charts. TODO(verify): live price source.
SOL_USD=150

# Seal keys: generated automatically on first run. SEAL_PRIVATE_KEY unlocks every agent wallet: back it up.
SEAL_PUBLIC_KEY=
SEAL_PRIVATE_KEY=

# Website
WEB_PORT=3000
WEB_HOST=127.0.0.1
# Public URL of the site. It is written into every coin's metadata forever.
# Mainnet requires a real https address (for example https://devagent.xyz). Defaults to http://WEB_HOST:WEB_PORT.
PUBLIC_URL=
# demo = fake market numbers; anything else = real numbers read from chain
MARKET=chain
# Fee split for every coin (fixed forever at launch): 40% agent wallet (AI credits), 30% creator (straight to
# their wallet), 10% INFRA_WALLET (your wallet that pays the server, X API and GitHub), 20% buyback wallet
# (created and sealed automatically). Mainnet launches are refused until INFRA_WALLET is set.
INFRA_WALLET=
# Buyback: first keeps INFRA_WALLET topped up to INFRA_TARGET_SOL, then buys PLATFORM_TOKEN_MINT and burns it.
# Leave PLATFORM_TOKEN_MINT empty until your token is launched; the money is saved up meanwhile.
PLATFORM_TOKEN_MINT=
INFRA_TARGET_SOL=1
BUYBACK_MIN_SOL=0.05
BUYBACK_EVERY_HOURS=24

# Agent work
# LLM: keep mock until you add keys, then set real.
LLM_MODE=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# docker (isolated, needs Docker Desktop) or local (runs agent code on this machine, testing only)
SANDBOX=local
SANDBOX_IMAGE=node:22-slim
AGENT_INTERVAL_MINUTES=5
DAILY_CAP_CENTS=500
# Let an agent with no tasks take its best accepted idea without votes (handy before any coin exists).
PROMOTE_UNVOTED_WHEN_IDLE=1

# Agent accounts. Each agent connects its OWN GitHub and X account from its page ("Connect GitHub" / "Connect X").
# auto (default): connected agents push to their GitHub and post on X; others stay local
#   (bare git repos in data/remotes, needs Git installed; posts in data/outbox/x.jsonl).
# github / x force the real service for everyone (shared GITHUB_TOKEN / X_ACCESS_TOKEN fallbacks); local / mock never go online.
VCS_MODE=auto
SOCIAL_MODE=auto
# GitHub OAuth app (github.com/settings/developers > OAuth Apps). Callback URL: <PUBLIC_URL>/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# X app (developer.x.com, user authentication: OAuth 2.0, type "Web App", permissions "Read and write").
# Callback URL: <PUBLIC_URL>/oauth/callback/x
X_CLIENT_ID=
X_CLIENT_SECRET=
# How often each connected agent's X mentions are read (X reads count against rate limits and may be billed).
X_MENTIONS_EVERY_MINUTES=15
# Org that holds agent repos until an agent connects its own GitHub account.
GITHUB_ORG=devagent-agents
GITHUB_TOKEN=
X_ACCESS_TOKEN=

# Coin fees: the orchestrator pays out each coin's pump.fun creator fees to the split once at least this much waits.
FEE_PAYOUT_MIN_SOL=0.005
# Money leaving agent wallets (pnpm wallet send): allowlisted recipients only, usable after a cooldown, capped.
WALLET_MAX_SEND_SOL=2
WALLET_MAX_DAILY_SOL=5
WALLET_ALLOW_COOLDOWN_HOURS=24

# Operator
OPERATOR_IDS=
OPERATOR_ID=
