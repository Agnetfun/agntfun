# DevAgent production settings (MAINNET). The VPS setup script splits this into two files:
#   /etc/devagent/app.env           read by the website AND the orchestrator (no private keys)
#   /etc/devagent/orchestrator.env  read by the orchestrator only (SEAL_PRIVATE_KEY, model keys)
# Fill every value marked REQUIRED, then run: pnpm preflight /etc/devagent/app.env /etc/devagent/orchestrator.env

# ---------- app.env (website + orchestrator) ----------
NODE_ENV=production
LOG_LEVEL=info
DB_PATH=./data/devagent.db

# Real SOL. Both lines are needed for mainnet.
SOLANA_CLUSTER=mainnet-beta
REAL_MONEY=1
# REQUIRED: a mainnet RPC (the public one is rate limited), for example Helius: https://mainnet.helius-rpc.com/?api-key=...
SOLANA_RPC_URL=
SOL_USD=150

# The website listens on localhost; Caddy serves it over https on your domain.
WEB_HOST=127.0.0.1
WEB_PORT=3000
# REQUIRED: your https address, no trailing slash. OAuth callbacks are <PUBLIC_URL>/oauth/callback/x and /github.
PUBLIC_URL=https://
# The website must never hold the private seal key in production.
WEB_STRICT_KEYS=1
SEAL_PUBLIC_KEY=

MARKET=chain
# REQUIRED: your wallet that receives the 10% infra share (pays the server, X API, model credits).
INFRA_WALLET=
# Empty until your platform token exists; the 20% buyback share is saved up meanwhile.
PLATFORM_TOKEN_MINT=
PLATFORM_TOKEN_SYMBOL=
INFRA_TARGET_SOL=1
BUYBACK_MIN_SOL=0.05
BUYBACK_EVERY_HOURS=24
FEE_PAYOUT_MIN_SOL=0.005

# Accounts: one platform GitHub OAuth app and one X app (callbacks on PUBLIC_URL, see ACCOUNTS-SETUP.md).
VCS_MODE=auto
SOCIAL_MODE=auto
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_MENTIONS_EVERY_MINUTES=15
X_POST_LINKS=0

# Voting: ideas are built only with holder support. Never skip votes in production.
PROMOTE_UNVOTED_WHEN_IDLE=0
VOTE_MIN_VOTERS=3
VOTE_MIN_SUPPLY_PCT=1

# Agents and their sandbox (Docker isolates each agent's code).
SANDBOX=docker
SANDBOX_IMAGE=node:22-slim
AGENT_INTERVAL_MINUTES=360
DAILY_CAP_CENTS=500
CHAIN_POLL_SECONDS=60
PRICE_POLL_SECONDS=10

# ---------- orchestrator.env (orchestrator only) ----------
# REQUIRED: unlocks every agent wallet. Generated by the setup script. BACK IT UP OFF THE SERVER.
SEAL_PRIVATE_KEY=
# Model: real mode with OpenRouter (credits bought with crypto) or Anthropic directly.
LLM_MODE=real
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=anthropic/claude-opus-5.5
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_LOW_USD=10
ANTHROPIC_API_KEY=
CODING_MODE=pro
